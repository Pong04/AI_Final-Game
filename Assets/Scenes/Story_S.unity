        dialogue: "\uB9DD\uD588\uB2E4\uC544\uC544\uC544!!!"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uC5B4\uC81C \uCD9C\uC11D \uC870\uC2EC\uD558\uB77C\uACE0 \uADF8\uB807\uAC8C
          \uB4E4\uC5C8\uB294\uB370!!!"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uC77C\uB2E8 \uD559\uAD50\uBD80\uD130 \uAC00\uC57C \uD574!!!"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uD5C9\uD5C9\u2026 \uC5B4\uCC0C\uC800\uCC0C \uC815\uBB38\uAE4C\uC9C4
          \uC654\uB294\uB370 \uC778\uBB38\uB300\uAE4C\uC9C0 \uC65C \uC774\uB807\uAC8C
          \uBA3C \uAC70\uC57C\u2026"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "9\uC2DC 1\uAD50\uC2DC \uC804\uACF5\uD544\uC218\u2026 \uCD9C\uC11D
          \uBD80\uB974\uAE30\uAE4C\uC9C0 5\uBD84."
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uC774\uB300\uB85C\uBA74 \uC9C0\uAC01 \uD655\uC815\uC778\uB370
          \uC5B4\uB5A1\uD558\uC9C0\u2026?! \uB204\uAD6C\uD55C\uD14C\uB77C\uB3C4 \uC5F0\uB77D\uC744
          \uD574\uB458\uAE4C?"
      choices:
      - text: "A. \uC544\uBB34\uC5D0\uAC8C \uC5F0\uB77D \uC548 \uD558\uACE0 \uB6F4\uB2E4."
        lines:
        - speaker: "\uC8FC\uC778\uACF5"
          dialogue: "\uC5F0\uB77D\uD560 \uC2DC\uAC04\uC5D0 \uD55C \uAC78\uC74C\uC774\uB77C\uB3C4
            \uB354 \uB6F0\uC790!"
      - text: "B. \uB3D9\uAE30\uC5D0\uAC8C \uC5F0\uB77D\uD55C\uB2E4."
        lines:
        - speaker: "\uC8FC\uC778\uACF5"
          dialogue: "(\uC804\uD654) \uC9C0\uD6C8\uC544! \uB098 \uC9C0\uAE08 \uC815\uBB38\uC778\uB370
            \uAD50\uC218\uB2D8 \uB4E4\uC5B4\uC624\uC168\uC5B4?"
        - speaker: "\uC9C0\uD6C8"
          dialogue: "\uC544\uC9C1! \uADFC\uB370 \uBCF5\uB3C4\uC5D0\uC11C \uBAA9\uC18C\uB9AC
            \uB4E4\uB824. 3\uBD84 \uC548\uC5D0 \uC640\uB77C!"
        - speaker: "\uC8FC\uC778\uACF5"
          dialogue: "\uC73C\uC544\uC544 \uC54C\uC558\uC5B4!!"
      - text: "C. \uAD50\uC218\uB2D8\uAED8 \uC5F0\uB77D\uD55C\uB2E4."
        lines:
        - speaker: "\uC8FC\uC778\uACF5"
          dialogue: "(\uC804\uD654) \uAD50\uC218\uB2D8, \uC548\uB155\uD558\uC138\uC694.
            \uC800 OO\uC785\uB2C8\uB2E4. \uC8C4\uC1A1\uD558\uC9C0\uB9CC \uC624\uB298
            \uC870\uAE08 \uB2A6\uC744 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4\u2026"
        - speaker: "\uAD50\uC218\uB2D8"
          dialogue: "\uBBF8\uB9AC \uC5F0\uB77D\uD574\uC918\uC11C \uACE0\uB9D9\uB124.
            \uCD9C\uC11D \uBD80\uB974\uAE30 \uC804\uAE4C\uC9C0\uB9CC \uC624\uBA74
            \uC778\uC815\uD574\uC8FC\uC9C0. \uC11C\uB450\uB974\uAC8C."
        - speaker: "\uC8FC\uC778\uACF5"
          dialogue: "\uB124! \uCD5C\uB300\uD55C \uBE68\uB9AC \uAC00\uACA0\uC2B5\uB2C8\uB2E4!"
      afterChoiceLines:
      - speaker: 
        dialogue: "\uCEA0\uD37C\uC2A4\uB97C \uAC00\uB85C\uC9C8\uB7EC \uAC15\uC758\uC2E4\uAE4C\uC9C0
          \uB3C4\uCC29\uD558\uB77C!"
      hasMinigame: 1
      gradeName: "\uCD9C\uC11D"
      resultIntroLines:
      - speaker: 
        dialogue: "\uACB0\uACFC \uD654\uBA74 \u2013 \uCD9C\uC11D \uB4F1\uAE09: {grade}"
      resultA:
      - speaker: 
        dialogue: "\uCD9C\uC11D \uBD80\uB974\uAE30 \uC804, \uC5EC\uC720 \uC788\uAC8C
          \uC790\uB9AC\uC5D0 \uC549\uB294 \uC8FC\uC778\uACF5"
      - speaker: "\uC9C0\uD6C8"
        dialogue: "(\uC18D\uC0AD\uC774\uBA70) \uC624, \uC0DD\uAC01\uBCF4\uB2E4 \uBE68\uB9AC
          \uC654\uB124?"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uD6C4\u2026 \uC774 \uC815\uB3C4\uBA74 \uC120\uBC29\uC774\uC9C0."
      resultB:
      - speaker: 
        dialogue: "\uCD9C\uC11D\uC744 \uBD80\uB974\uB294 \uB3C4\uC911, \uAC15\uC758\uC2E4
          \uB4B7\uBB38\uC744 \uC0B4\uBA70\uC2DC \uC5EC\uB294 \uC8FC\uC778\uACF5"
      - speaker: "\uAD50\uC218\uB2D8"
        dialogue: "\u2026OO?"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uB124! \uC5EC\uAE30 \uC788\uC2B5\uB2C8\uB2E4!"
      - speaker: "\uC9C0\uD6C8"
        dialogue: "(\uC18D\uC0AD\uC774\uBA70) \uC640\u2026 \uC9C4\uC9DC \uAC04\uB2F9\uAC04\uB2F9\uD588\uB2E4."
      resultF:
      - speaker: "\uAD50\uC218\uB2D8"
        dialogue: "OO\u2026 \uCD9C\uC11D\uC740 \uC774\uBBF8 \uB2E4 \uBD88\uB800\uB124.
          \uC624\uB298\uC740 \uC9C0\uAC01 \uCC98\uB9AC\uD558\uACA0\uB124."
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "(\uC18D\uB9C8\uC74C) \uCCAB \uC218\uC5C5\uBD80\uD130 \uC774\uB7EC\uBA74
          \uC548 \uB418\uB294\uB370\u2026"
      failEndsGame: 0
      failEndingLines: []
      outroLines:
      - speaker: "\uAD50\uC218\uB2D8"
        dialogue: "\uC544, \uADF8\uB9AC\uACE0 \uB2E4\uC74C \uC8FC\uBD80\uD130 \uC870\uBCC4\uACFC\uC81C
          \uC2DC\uC791\uC774\uB124. \uC870 \uD3B8\uC131\uC740 \uC624\uB298 \uC800\uB141\uC5D0
          \uACF5\uC9C0\uD558\uACA0\uB124."
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uC870\uBCC4\uACFC\uC81C\u2026 \uCD9C\uC11D \uD558\uB098 \uB118\uAE30\uB2C8\uAE4C
          \uC0B0\uC774 \uB610 \uD558\uB098 \uC788\uB124\u2026"
      - speaker: 
        dialogue: "EP.1 \uD074\uB9AC\uC5B4!"
    - episodeName: "EP.2 \uC870\uBCC4\uACFC\uC81C"
      introLines:
      - speaker: 
        dialogue: "\uC77C\uC8FC\uC77C \uD6C4 / \uC8FC\uC778\uACF5\uC758 \uC790\uCDE8\uBC29,
          \uBC24 11\uC2DC"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "(\uB2E8\uD1A1\uBC29) \uC790\uB8CC\uC870\uC0AC \uAC01\uC790 \uB9E1\uC740
          \uBD80\uBD84, \uB0B4\uC77C\uAE4C\uC9C0 \uC62C\uB824\uC8FC\uC2E4 \uC218
          \uC788\uC744\uAE4C\uC694?"
      - speaker: "\uC870\uC6D0A"
        dialogue: "(\uB2E8\uD1A1\uBC29) \uC557 \uC8C4\uC1A1\uD574\uC694\u3160\u3160
          \uC774\uBC88 \uC8FC \uB2E4\uB978 \uACFC\uBAA9 \uC2DC\uD5D8\uC774 \uC788\uC5B4\uC11C\u2026"
      - speaker: 
        dialogue: "\uC870\uC6D0B, \uC870\uC6D0C\uB294 \uC77D\uACE0 \uB2F5\uC774 \uC5C6\uB2E4."
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uACF5\uC9C0 \uC62C\uB9B0 \uC9C0 \uC0AC\uD758\uC9F8\uC778\uB370\u2026
          \uB9C8\uAC10\uC740 \uAE08\uC694\uC77C\uC774\uACE0, \uAE30\uB9D0\uACE0\uC0AC\uB3C4
          \uCF54\uC55E\uC774\uACE0."
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uC774\uAC78\u2026 \uC5B4\uB5BB\uAC8C \uD574\uC57C \uD558\uC9C0?"
      choices:
      - text: "A. \uD63C\uC790 \uC548\uACE0 \uB2E4 \uCC98\uB9AC\uD55C\uB2E4."
        lines:
        - speaker: "\uC8FC\uC778\uACF5"
          dialogue: "\u2026\uADF8\uB0E5 \uB0B4\uAC00 \uB2E4 \uD558\uB294 \uAC8C \uBE60\uB974\uACA0\uB2E4.
            \uAE30\uB2E4\uB9AC\uB2E4\uAC04 \uB9C8\uAC10 \uB193\uCCD0."
        - speaker: 
          dialogue: "\uC313\uC5EC\uAC00\uB294 \uC5D0\uB108\uC9C0\uB4DC\uB9C1\uD06C
            \uCE94, \uBC24\uC774 \uC0C8\uB3C4\uB85D \uAEBC\uC9C0\uC9C0 \uC54A\uB294
            \uB178\uD2B8\uBD81 \uBD88\uBE5B"
      - text: "B. \uC5F0\uB77D\uD574\uC11C \uC870\uC6D0 \uCC38\uC5EC\uC728\uC744
          \uB192\uC778\uB2E4."
        lines:
        - speaker: "\uC8FC\uC778\uACF5"
          dialogue: "(\uB2E8\uD1A1\uBC29) \uB2E4\uB4E4 \uBC14\uC058\uC2E0 \uAC70
            \uC54C\uC544\uC694! \uB300\uC2E0 \uC5ED\uD560\uC744 \uC791\uAC8C \uB098\uB220\uBCFC\uAC8C\uC694.
            A\uB2D8\uC740 \uC790\uB8CC 2\uAC1C\uB9CC, B\uB2D8\uC740 \uD45C\uC9C0\uB791
            \uBAA9\uCC28, C\uB2D8\uC740 \uACB0\uB860 \uC815\uB9AC \uBD80\uD0C1\uB4DC\uB824\uC694.
            \uB0B4\uC77C \uBC24 9\uC2DC\uC5D0 10\uBD84\uB9CC \uC90C\uC73C\uB85C \uD655\uC778\uD574\uC694!"
        - speaker: "\uC870\uC6D0A"
          dialogue: "\uD5C9 \uADF8 \uC815\uB3C4\uBA74 \uD560 \uC218 \uC788\uC5B4\uC694!
            \uB0B4\uC77C\uAE4C\uC9C0 \uC62C\uB9B4\uAC8C\uC694!"
        - speaker: "\uC870\uC6D0B"
          dialogue: "\uB2F5 \uB2A6\uC5B4\uC11C \uC8C4\uC1A1\uD574\uC694\u2026 \uBAA9\uCC28
            \uC81C\uAC00 \uD560\uAC8C\uC694!"
        - speaker: "\uC8FC\uC778\uACF5"
          dialogue: "\uD734\u2026 \uC9C4\uC791 \uC774\uB807\uAC8C \uB9D0\uD560\uAC78."
      afterChoiceLines:
      - speaker: 
        dialogue: "\uB9C8\uAC10 \uC804\uAE4C\uC9C0 \uBCF4\uACE0\uC11C\uB97C \uC644\uC131\uD558\uB77C!"
      hasMinigame: 1
      gradeName: "\uC870\uBCC4\uACFC\uC81C"
      resultIntroLines:
      - speaker: 
        dialogue: "\uACB0\uACFC \uD654\uBA74 \u2013 \uC870\uBCC4\uACFC\uC81C \uB4F1\uAE09:
          {grade}"
      resultA:
      - speaker: 
        dialogue: "\u2018\uACFC\uC81C \uC81C\uCD9C\uC774 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\u2019"
      - speaker: "\uC870\uC6D0A"
        dialogue: "(\uB2E8\uD1A1\uBC29) \uC640 \uBCF4\uACE0\uC11C \uD004\uB9AC\uD2F0
          \uBBF8\uCCE4\uB2E4\u2026 \uACE0\uC0DD \uB9CE\uC73C\uC168\uC5B4\uC694!!"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uC81C\uCD9C \uC644\uB8CC\u2026! \uC774\uAC74 \uC9C4\uC9DC \uC798
          \uC37C\uB2E4."
      resultB:
      - speaker: 
        dialogue: "\u2018\uACFC\uC81C \uC81C\uCD9C\uC774 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\u2019"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uC624\uD0C0\uAC00 \uC880 \uC788\uC5C8\uB358 \uAC83 \uAC19\uC740\uB370\u2026
          \uADF8\uB798\uB3C4 \uB0C8\uB2E4!"
      resultF:
      - speaker: 
        dialogue: "\u2018\uC81C\uCD9C \uAE30\uD55C\uC774 \uC9C0\uB0AC\uC2B5\uB2C8\uB2E4.\u2019"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "1\uBD84\u2026 \uB531 1\uBD84 \uB2A6\uC5C8\uB294\uB370\u2026!"
      failEndsGame: 1
      failEndingLines:
      - speaker: 
        dialogue: "\uC0AC\uD758 \uD6C4 / \uC8FC\uC778\uACF5\uC758 \uC790\uCDE8\uBC29"
      - speaker: "\uD559\uC0AC\uAD00\uB9AC\uCC98 \uC9C1\uC6D0"
        dialogue: "(\uC804\uD654) OO \uD559\uC0DD, \uC804\uACF5\uD544\uC218 \uACFC\uBAA9
          \uC870\uBCC4\uACFC\uC81C \uBBF8\uC81C\uCD9C\uB85C F\uAC00 \uD655\uC815\uB410\uC2B5\uB2C8\uB2E4."
      - speaker: "\uD559\uC0AC\uAD00\uB9AC\uCC98 \uC9C1\uC6D0"
        dialogue: "\uC9C0\uB09C \uD559\uAE30 \uD559\uC0AC\uACBD\uACE0\uAE4C\uC9C0
          \uB204\uC801\uB3FC\uC11C\u2026 \uC774\uBC88 \uD559\uAE30 \uC81C\uC801 \uB300\uC0C1\uC785\uB2C8\uB2E4."
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uC81C, \uC81C\uC801\uC774\uC694\u2026? \uC878\uC5C5\uC774 \uC544\uB2C8\uB77C\u2026
          \uC81C\uC801\u2026?"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "(\uBA4D\uD558\uB2C8) \uC870\uBCC4\uACFC\uC81C \uD558\uB098 \uB54C\uBB38\uC5D0\u2026
          4\uB144\uC774\u2026"
      - speaker: 
        dialogue: "ENDING 00 \u2013 \uC81C\uC801\uC740 \uB0B4 \uC6B4\uBA85..."
      outroLines:
      - speaker: "\uC9C0\uD6C8"
        dialogue: "\uC57C, \uC870\uBCC4\uACFC\uC81C \uB05D\uB0AC\uB2E4\uBA70? \uACE0\uC0DD\uD588\uB2E4.
          \uADFC\uB370 \uB108 \uAE30\uB9D0 \uBC94\uC704 \uC5B4\uB514\uAE4C\uC9C0
          \uBD24\uC5B4?"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\u2026\uAE30\uB9D0? \uBC8C\uC368?"
      - speaker: "\uC9C0\uD6C8"
        dialogue: "\uBAA8\uB808\uC57C."
      - speaker: 
        dialogue: "EP.2 \uD074\uB9AC\uC5B4!"
    - episodeName: "EP.3 \uAE30\uB9D0\uACE0\uC0AC"
      introLines:
      - speaker: 
        dialogue: "\uAE30\uB9D0\uACE0\uC0AC D-1 / \uB3C4\uC11C\uAD00 \uC5F4\uB78C\uC2E4,
          \uBC24 10\uC2DC"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "(\uCC45\uC7A5\uC744 \uB118\uAE30\uBA70) \uC544\uC9C1 \uBC94\uC704\uAC00
          \uBC18\uC774\uB098 \uB0A8\uC558\uB294\uB370\u2026 \uC774\uAC70 \uB2E4 \uBCFC
          \uC218 \uC788\uB098?"
      - speaker: "\uC9C0\uD6C8"
        dialogue: "\uB09C \uBA3C\uC800 \uAC04\uB2E4. \uBB34\uB9AC\uD558\uC9C0 \uB9C8\uB77C.
          \uB0B4\uC77C \uC2DC\uD5D8 \uBCF4\uB2E4\uAC00 \uC878\uBA74 \uB05D\uC774\uC57C."
      - speaker: 
        dialogue: "\uC548\uB0B4\uBC29\uC1A1: \u201C\uC5F4\uB78C\uC2E4 \uC774\uC6A9
          \uC2DC\uAC04\uC774 30\uBD84 \uB0A8\uC558\uC2B5\uB2C8\uB2E4.\u201D"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uB05D\uAE4C\uC9C0 \uB2E4 \uBCF4\uACE0 \uAC08 \uAC70\uB0D0, \uD575\uC2EC\uB9CC
          \uBCF4\uACE0 \uCEE8\uB514\uC158\uC744 \uCC59\uAE38 \uAC70\uB0D0\u2026"
      choices:
      - text: "A. \uBC24\uC0D8 \uACF5\uBD80\uD55C\uB2E4."
        lines:
        - speaker: "\uC8FC\uC778\uACF5"
          dialogue: "\uC624\uB298 \uBC24\uC740 \uC548 \uC794\uB2E4. \uBC94\uC704
            \uB05D\uAE4C\uC9C0 \uAC04\uB2E4!"
        - speaker: "\uC8FC\uC778\uACF5"
          dialogue: "\uBC94\uC704\uB294 \uB2E4 \uBD24\uB2E4\u2026 \uADFC\uB370 \uB208\uC774\u2026
            \uC548 \uB5A0\uC838\u2026"
      - text: "B. \uD53C\uACE4\uD558\uB2C8\uAE4C \uD575\uC2EC\uB9CC \uBCF4\uACE0
          \uC794\uB2E4."
        lines:
        - speaker: "\uC8FC\uC778\uACF5"
          dialogue: "\uC678\uC6B4 \uAC83\uB9CC\uC774\uB77C\uB3C4 \uD655\uC2E4\uD558\uAC8C
            \uD558\uC790. \uC624\uB298\uC740 \uC790\uC790."
        - speaker: "\uC8FC\uC778\uACF5"
          dialogue: "\uAC1C\uC6B4\uD558\uB2E4! \u2026\uADFC\uB370 \uB4B7\uBD80\uBD84\uC740
            \uAC70\uC758 \uBABB \uBD24\uB294\uB370, \uAD1C\uCC2E\uACA0\uC9C0?"
      afterChoiceLines:
      - speaker: "\uAD50\uC218\uB2D8"
        dialogue: "\uCC45\uC0C1 \uC704\uC5D0 \uD544\uAE30\uAD6C\uB9CC \uB0A8\uAE30\uAC8C.
          \uC2DC\uD5D8 \uC2DC\uAC04\uC740 75\uBD84, \uC2DC\uC791\uD558\uC9C0."
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "(\uC18D\uB9C8\uC74C) \u2026\uCE68\uCC29\uD558\uC790. \uC544\uB294
          \uAC83\uBD80\uD130 \uB9DE\uCDB0 \uB098\uAC00\uBA74 \uB3FC."
      - speaker: 
        dialogue: "\uAC1C\uB150\uACFC \uC815\uC758\uB97C \uC9DD\uC9C0\uC5B4 \uC2DC\uD5D8\uC744
          \uD480\uC5B4\uB77C!"
      hasMinigame: 1
      gradeName: "\uAE30\uB9D0\uACE0\uC0AC"
      resultIntroLines:
      - speaker: 
        dialogue: "\uACB0\uACFC \uD654\uBA74 \u2013 \uAE30\uB9D0\uACE0\uC0AC \uB4F1\uAE09:
          {grade}"
      resultA:
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uB9C8\uC9C0\uB9C9 \uBB38\uC81C\uAE4C\uC9C0 \uB2E4 \uC4F0\uACE0\u2026
          \uAC80\uD1A0\uAE4C\uC9C0 \uB05D!"
      - speaker: "\uC9C0\uD6C8"
        dialogue: "\uD45C\uC815 \uBCF4\uB2C8\uAE4C \uC2DC\uD5D8 \uC798 \uBD24\uB124?"
      resultB:
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uB2E4 \uC4F0\uAE34 \uD588\uB294\uB370\u2026 \uB450\uC138 \uBB38\uC81C\uB294
          \uCC0D\uC5C8\uC5B4."
      resultF:
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uC544\u2026 \uB9C8\uC9C0\uB9C9 \uC7A5\uC744 \uBABB \uB118\uACBC\uC5B4\u2026"
      failEndsGame: 0
      failEndingLines: []
      outroLines:
      - speaker: 
        dialogue: "\uB760\uB9C1- \uBA54\uC77C \uC54C\uB9BC \u2018[\uC878\uC5C5\uB17C\uBB38]
          \uCD5C\uC885 \uC0C1\uB2F4 \uC77C\uC815 \uC548\uB0B4 \u2013 \uAE08\uC694\uC77C
          \uC624\uD6C4 2\uC2DC, \uAD50\uC218 \uC5F0\uAD6C\uC2E4\u2019"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uB9C8\uC9C0\uB9C9\u2026 \uAD00\uBB38\uC774\uB2E4."
      - speaker: 
        dialogue: "EP.3 \uD074\uB9AC\uC5B4!"
    - episodeName: "EP.4 \uC878\uC5C5\uC0C1\uB2F4/\uC878\uC5C5\uB17C\uBB38"
      introLines:
      - speaker: 
        dialogue: "\uAE08\uC694\uC77C \uC624\uD6C4 2\uC2DC / \uAD50\uC218 \uC5F0\uAD6C\uC2E4"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uAD50\uC218\uB2D8, OO\uC785\uB2C8\uB2E4. \uC878\uC5C5\uB17C\uBB38
          \uC0C1\uB2F4 \uBC1B\uC73C\uB7EC \uC654\uC2B5\uB2C8\uB2E4."
      - speaker: "\uAD50\uC218\uB2D8"
        dialogue: "(\uB17C\uBB38\uC744 \uB118\uAE30\uBA70) \uC74C\u2026 \uC8FC\uC81C\uB294
          \uC88B\uB124. \uADF8\uB7F0\uB370 3\uC7A5 \uBD84\uC11D\uC758 \uADFC\uAC70\uAC00
          \uC57D\uD574. \uC120\uD589\uC5F0\uAD6C \uBE44\uAD50\uB3C4 \uBE60\uC838
          \uC788\uACE0."
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uC544\u2026 \uB124\u2026"
      - speaker: "\uAD50\uC218\uB2D8"
        dialogue: "\uB2E4\uC74C \uC8FC \uCD5C\uC885 \uC2EC\uC0AC \uC804\uAE4C\uC9C0
          \uBCF4\uC644\uD574 \uC624\uAC8C. \uC774\uBC88\uC774 \uB9C8\uC9C0\uB9C9
          \uAE30\uD68C\uC77C\uC138."
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uC77C\uC8FC\uC77C \uC548\uC5D0 \uC774\uAC78 \uB2E4 \uACE0\uCE60
          \uC218 \uC788\uC744\uAE4C\u2026"
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uD63C\uC790 \uD53C\uB4DC\uBC31\uC744 \uBD84\uC11D\uD574\uC11C
          \uACE0\uCCD0\uBCFC\uAE4C, \uC544\uB2C8\uBA74 \uAD50\uC218\uB2D8\uAED8 \uD55C
          \uBC88 \uB354 \uC5EC\uCB64\uBCFC\uAE4C?"
      choices:
      - text: "A. \uD53C\uB4DC\uBC31\uC744 \uC9C1\uC811 \uBD84\uC11D\uD574 \uC218\uC815\uD55C\uB2E4."
        lines:
        - speaker: "\uC8FC\uC778\uACF5"
          dialogue: "\u2018\uADFC\uAC70\uAC00 \uC57D\uD558\uB2E4\u2019\uB294 \uAC74\u2026
            \uB370\uC774\uD130\uAC00 \uBD80\uC871\uD558\uB2E4\uB294 \uB73B\uC774\uACA0\uC9C0?
            \uC77C\uB2E8 \uB0B4\uAC00 \uD574\uBCF4\uC790."
      - text: "B. \uAD50\uC218\uB2D8\uC5D0\uAC8C \uCD94\uAC00 \uC0C1\uB2F4\uC744
          \uC694\uCCAD\uD55C\uB2E4."
        lines:
        - speaker: "\uC8FC\uC778\uACF5"
          dialogue: "\uAD50\uC218\uB2D8, \uD53C\uB4DC\uBC31 \uC8FC\uC2E0 3\uC7A5
            \uAD00\uB828\uD574\uC11C 10\uBD84\uB9CC \uB354 \uC5EC\uCB64\uBD10\uB3C4
            \uB420\uAE4C\uC694?"
        - speaker: "\uAD50\uC218\uB2D8"
          dialogue: "\uBB3C\uB860\uC774\uC9C0. \uC774\uB807\uAC8C \uB2E4\uC2DC \uCC3E\uC544\uC624\uB294
            \uD559\uC0DD\uC774 \uC624\uD788\uB824 \uBC18\uAC11\uB124. \uC774 \uB17C\uBB38
            \uB450 \uD3B8\uC744 \uCC38\uACE0\uD574 \uBCF4\uAC8C."
      afterChoiceLines:
      - speaker: 
        dialogue: "\uC77C\uC8FC\uC77C \uD6C4 / \uC878\uC5C5\uB17C\uBB38 \uCD5C\uC885
          \uC2EC\uC0AC\uC7A5"
      - speaker: "\uAD50\uC218\uB2D8"
        dialogue: "\uADF8\uB7FC \uBC1C\uD45C \uC2DC\uC791\uD558\uC9C0. \uC9C8\uBB38\uC740
          \uBC1C\uD45C \uD6C4\uC5D0 \uBC1B\uACA0\uB124."
      - speaker: 
        dialogue: "\uC3DF\uC544\uC9C0\uB294 \uC9C8\uBB38\uC744 \uD53C\uD558\uBA70
          \uB05D\uAE4C\uC9C0 \uBC84\uD168\uB77C!"
      hasMinigame: 1
      gradeName: "\uC878\uC5C5\uB17C\uBB38"
      resultIntroLines:
      - speaker: 
        dialogue: "\uACB0\uACFC \uD654\uBA74 \u2013 \uC878\uC5C5\uB17C\uBB38 \uB4F1\uAE09:
          {grade}"
      resultA:
      - speaker: "\uAD50\uC218\uB2D8"
        dialogue: "\uC9C8\uBB38\uC5D0 \uB9C9\uD798\uC774 \uC5C6\uAD70. \uC9C0\uB09C\uBC88\uACFC\uB294
          \uC644\uC804\uD788 \uB2E4\uB978 \uB17C\uBB38\uC774\uC57C."
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uAC00, \uAC10\uC0AC\uD569\uB2C8\uB2E4!!"
      resultB:
      - speaker: "\uAD50\uC218\uB2D8"
        dialogue: "\uBA87 \uAD70\uB370 \uC544\uC27D\uC9C0\uB9CC\u2026 \uD1B5\uACFC\uB85C
          \uD558\uC9C0. \uC218\uACE0\uD588\uB124."
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "(\uC18D\uB9C8\uC74C) \uD734\u2026 \uC0B4\uC558\uB2E4."
      resultF:
      - speaker: "\uAD50\uC218\uB2D8"
        dialogue: "\u2026\uC544\uC9C1 \uBCF4\uC644\uD560 \uBD80\uBD84\uC774 \uB9CE\uAD70.
          \uC774\uB300\uB85C\uB294 \uD1B5\uACFC\uAC00 \uC5B4\uB835\uACA0\uB124."
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\u2026\u2026"
      failEndsGame: 0
      failEndingLines: []
      outroLines:
      - speaker: "\uC8FC\uC778\uACF5"
        dialogue: "\uCD9C\uC11D, \uD300\uD50C, \uC2DC\uD5D8, \uB17C\uBB38\u2026 \uD560
          \uC218 \uC788\uB294 \uAC74 \uB2E4 \uD588\uC5B4. \uC774\uC81C \uACB0\uACFC\uB9CC
          \uB0A8\uC558\uB2E4."
    finalIntroLines:
    - speaker: "\uD559\uC0AC\uAD00\uB9AC\uCC98 \uC9C1\uC6D0"
      dialogue: "OO \uD559\uC0DD, \uCD5C\uC885 \uC131\uC801 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4."
    - speaker: 
      dialogue: "\uCD5C\uC885 \uC131\uC801\uD45C \u2013 {report}"
    endingGraduate:
    - speaker: "\uD559\uC0AC\uAD00\uB9AC\uCC98 \uC9C1\uC6D0"
      dialogue: "\uCD95\uD558\uD569\uB2C8\uB2E4. \uC878\uC5C5 \uC694\uAC74 \uBAA8\uB450
        \uCDA9\uC871\uC785\uB2C8\uB2E4."
    - speaker: "\uC8FC\uC778\uACF5"
      dialogue: "\u2026\uC9C4\uC9DC\uC694? \uC9C4\uC9DC\uB85C\uC694?!"
    - speaker: "\uC8FC\uC778\uACF5"
      dialogue: "\uBB34\uC0AC\uD788\u2026 \uC878\uC5C5\uD588\uB2E4!!!"
    - speaker: 
      dialogue: "ENDING 01 \u2013 \uBB34\uC0AC\uD788 \uC878\uC5C5"
    endingRepeat:
    - speaker: "\uD559\uC0AC\uAD00\uB9AC\uCC98 \uC9C1\uC6D0"
      dialogue: "\u2026\uC544\uC27D\uC9C0\uB9CC \uC878\uC5C5 \uAE30\uC900\uC5D0 \uBBF8\uB2EC\uC785\uB2C8\uB2E4.
        \uB2E4\uC74C \uD559\uAE30\uC5D0 \uCD94\uAC00 \uB4F1\uB85D\uD558\uC154\uC57C
        \uD574\uC694."
    - speaker: "\uC8FC\uC778\uACF5"
      dialogue: "\uD55C \uD559\uAE30\uB9CC\u2026 \uB354\u2026"
    - speaker: "\uC8FC\uC778\uACF5"
      dialogue: "(\uC8FC\uBA39\uC744 \uBD88\uB048 \uC950\uBA70) \u2026\uB2E4\uC74C
        \uD559\uAE30\uC5D4, \uC9C4\uC9DC\uB85C \uBB34\uC0AC\uD788 \uC878\uC5C5\uD55C\uB2E4!!!"
    - speaker: 
      dialogue: "ENDING 02 \u2013 \uD55C \uD559\uAE30\uB9CC \uB354..."
    endingExcellent:
    - speaker: "\uD559\uC0AC\uAD00\uB9AC\uCC98 \uC9C1\uC6D0"
      dialogue: "\uCD95\uD558\uD569\uB2C8\uB2E4. \uC131\uC801\uC774 \uC544\uC8FC
        \uC6B0\uC218\uD558\uB124\uC694. \uC878\uC5C5\uC785\uB2C8\uB2E4."
    - speaker: "\uAD50\uC218\uB2D8"
      dialogue: "\uC798 \uBC84\uD17C\uB124, OO. \uD639\uC2DC \uB300\uD559\uC6D0 \uC0DD\uAC01
        \uC788\uC73C\uBA74 \uC5F0\uB77D\uD558\uAC8C. \uC790\uB124 \uAC19\uC740 \uD559\uC0DD\uC774
        \uD544\uC694\uD558\uAC70\uB4E0."
    - speaker: "\uC8FC\uC778\uACF5"
      dialogue: "\uB124\u2026? \uB300, \uB300\uD559\uC6D0\uC774\uC694\u2026?"
    - speaker: 
      dialogue: "1\uB144 \uD6C4 / \uC5F0\uAD6C\uC2E4, \uC0C8\uBCBD 2\uC2DC. \uB17C\uBB38
        \uB354\uBBF8 \uC0AC\uC774\uC5D0\uC11C \uC878\uACE0 \uC788\uB294 \uC8FC\uC778\uACF5"
    - speaker: 
      dialogue: "ENDING 03 \u2013 \uB05D\uB098\uC9C0 \uC54A\uC740 \uB300\uD559 \uC0DD\uD65C"
  playerName: OO
  italicNarration: 1
  startEpisodeIndex: 0
  onGameEnd:
    m_PersistentCalls:
      m_Calls: []
